<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>UK EPC Intelligent Address Matcher — Client Capabilities Showcase</title>
  <style>
    :root {
      --bg: #f5f7fa;
      --bg-accent: #edf2f7;
      --surface: #ffffff;
      --surface-subtle: #f8fafc;
      --surface-elevated: #ffffff;
      --ink: #0f172a;
      --ink-secondary: #334155;
      --ink-muted: #64748b;
      --border: #e2e8f0;
      --border-strong: #cbd5e1;

      --brand: #0f3d5e;
      --brand-light: #e0f2fe;
      --brand-accent: #0284c7;

      /* UK EPC & Governance Semantic Palette */
      --emerald-bg: #ecfdf5;
      --emerald-border: #a7f3d0;
      --emerald-text: #065f46;
      --emerald-solid: #059669;

      --teal-bg: #f0fdfa;
      --teal-border: #99f6e4;
      --teal-text: #115e59;
      --teal-solid: #0d9488;

      --amber-bg: #fffbeb;
      --amber-border: #fde68a;
      --amber-text: #92400e;
      --amber-solid: #d97706;

      --crimson-bg: #fef2f2;
      --crimson-border: #fecaca;
      --crimson-text: #991b1b;
      --crimson-solid: #dc2626;

      --slate-pill-bg: #f1f5f9;
      --slate-pill-text: #475569;

      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 4px 16px rgba(15, 23, 42, 0.06);
      --shadow-lg: 0 12px 32px rgba(15, 23, 42, 0.08);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
    }

    html[data-theme="dark"] {
      --bg: #0b1120;
      --bg-accent: #111827;
      --surface: #151f32;
      --surface-subtle: #1c2840;
      --surface-elevated: #1e293b;
      --ink: #f1f5f9;
      --ink-secondary: #cbd5e1;
      --ink-muted: #94a3b8;
      --border: #26354d;
      --border-strong: #384c6b;

      --brand: #38bdf8;
      --brand-light: rgba(56, 189, 248, 0.14);
      --brand-accent: #38bdf8;

      --emerald-bg: rgba(5, 150, 105, 0.16);
      --emerald-border: rgba(52, 211, 153, 0.35);
      --emerald-text: #6ee7b7;
      --emerald-solid: #10b981;

      --teal-bg: rgba(13, 148, 136, 0.18);
      --teal-border: rgba(45, 212, 191, 0.35);
      --teal-text: #5eead4;
      --teal-solid: #14b8a6;

      --amber-bg: rgba(217, 119, 6, 0.16);
      --amber-border: rgba(251, 191, 36, 0.35);
      --amber-text: #fcd34d;
      --amber-solid: #f59e0b;

      --crimson-bg: rgba(220, 38, 38, 0.16);
      --crimson-border: rgba(248, 113, 113, 0.35);
      --crimson-text: #fca5a5;
      --crimson-solid: #ef4444;

      --slate-pill-bg: #24324a;
      --slate-pill-text: #cbd5e1;

      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 6px 20px rgba(0, 0, 0, 0.35);
      --shadow-lg: 0 14px 36px rgba(0, 0, 0, 0.45);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Inter", "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    /* Sticky Top Navigation */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--surface);
      background: color-mix(in srgb, var(--surface) 90%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }

    .topbar-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 14px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand-mark {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--ink);
    }

    .epc-bars {
      display: flex;
      flex-direction: column;
      gap: 2.5px;
      width: 28px;
    }

    .epc-bars span {
      display: block;
      height: 4px;
      border-radius: 2px;
    }

    .epc-bars span:nth-child(1) { width: 55%; background: #059669; }
    .epc-bars span:nth-child(2) { width: 72%; background: #10b981; }
    .epc-bars span:nth-child(3) { width: 88%; background: #f59e0b; }
    .epc-bars span:nth-child(4) { width: 100%; background: #0284c7; }

    .brand-title {
      font-weight: 700;
      font-size: 16px;
      letter-spacing: -0.01em;
    }

    .brand-subtitle {
      font-size: 12px;
      color: var(--ink-muted);
      font-weight: 500;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-link {
      font-size: 13px;
      font-weight: 500;
      color: var(--ink-secondary);
      text-decoration: none;
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      transition: background 0.15s ease, color 0.15s ease;
    }

    .nav-link:hover {
      background: var(--surface-subtle);
      color: var(--ink);
    }

    .theme-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--surface-subtle);
      color: var(--ink-secondary);
      border: 1px solid var(--border);
      padding: 7px 13px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .theme-btn:hover {
      border-color: var(--border-strong);
      color: var(--ink);
    }

    /* Main Container */
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 28px;
    }

    /* Hero Section */
    .hero {
      padding: 52px 0 36px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--brand);
      background: var(--brand-light);
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 16px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 36px;
      align-items: center;
    }

    .hero h1 {
      font-size: clamp(28px, 3.3vw, 42px);
      line-height: 1.16;
      letter-spacing: -0.025em;
      margin: 0 0 16px;
      font-weight: 800;
    }

    .hero p.lead {
      font-size: 16.5px;
      color: var(--ink-secondary);
      margin: 0 0 24px;
      max-width: 680px;
    }

    .hero-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #0f3d5e;
      color: #ffffff;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      padding: 11px 20px;
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-sm);
      transition: transform 0.15s ease, background 0.15s ease;
    }

    html[data-theme="dark"] .btn-primary {
      background: #0284c7;
    }

    .btn-primary:hover {
      background: #0c314c;
      transform: translateY(-1px);
    }

    .hero-problem-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px 24px;
      box-shadow: var(--shadow-md);
    }

    .hero-problem-title {
      font-size: 12.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-muted);
      margin-bottom: 14px;
    }

    .vs-mini-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .vs-mini-item {
      padding: 11px 14px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      border: 1px solid var(--border);
      background: var(--surface-subtle);
    }

    .vs-mini-item strong {
      display: block;
      margin-bottom: 2px;
      font-size: 13px;
    }

    .vs-mini-item.bad {
      border-left: 4px solid var(--crimson-solid);
    }

    .vs-mini-item.good {
      border-left: 4px solid var(--emerald-solid);
      background: var(--emerald-bg);
      border-color: var(--emerald-border);
    }

    /* 3 Value Pillar Cards */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 44px;
    }

    .pillar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 22px 24px;
      box-shadow: var(--shadow-sm);
    }

    .pillar-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .pillar-card h3 {
      margin: 0 0 8px;
      font-size: 16.5px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .pillar-card p {
      margin: 0;
      font-size: 13.5px;
      color: var(--ink-secondary);
    }

    /* 4-Step Pipeline Strip */
    .pipeline-section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 26px 28px;
      margin-bottom: 48px;
      box-shadow: var(--shadow-sm);
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 20px;
    }

    .section-header h2 {
      margin: 0;
      font-size: 21px;
      font-weight: 750;
      letter-spacing: -0.015em;
    }

    .section-header span {
      font-size: 13.5px;
      color: var(--ink-muted);
    }

    .pipeline-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .pipe-step {
      position: relative;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 16px 18px;
    }

    .pipe-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: var(--brand);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    html[data-theme="dark"] .pipe-num {
      color: #0b1120;
    }

    .pipe-step h4 {
      margin: 0 0 6px;
      font-size: 14.5px;
      font-weight: 700;
    }

    .pipe-step p {
      margin: 0;
      font-size: 12.8px;
      color: var(--ink-secondary);
    }

    /* Interactive Scenario Explorer */
    .explorer-section {
      margin-bottom: 56px;
      scroll-margin-top: 76px;
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .filter-tab {
      background: var(--surface);
      color: var(--ink-secondary);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .filter-tab:hover {
      border-color: var(--border-strong);
      color: var(--ink);
    }

    .filter-tab.active {
      background: #0f3d5e;
      color: #ffffff;
      border-color: #0f3d5e;
    }

    html[data-theme="dark"] .filter-tab.active {
      background: #0284c7;
      border-color: #0284c7;
    }

    .step-nav-btns {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .step-btn {
      background: var(--surface);
      color: var(--ink-secondary);
      border: 1px solid var(--border);
      padding: 7px 12px;
      border-radius: var(--radius-sm);
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
    }

    .step-btn:hover {
      border-color: var(--border-strong);
      color: var(--ink);
    }

    .explorer-layout {
      display: grid;
      grid-template-columns: 330px 1fr;
      gap: 22px;
      align-items: start;
    }

    .scenario-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .scenario-item {
      text-align: left;
      width: 100%;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      padding: 13px 15px;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: var(--shadow-sm);
    }

    .scenario-item:hover {
      border-color: var(--border-strong);
      transform: translateX(2px);
    }

    .scenario-item.active {
      border-color: var(--brand-accent);
      background: var(--surface-elevated);
      box-shadow: var(--shadow-md);
    }

    .scen-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 5px;
    }

    .scen-cat-tag {
      font-size: 11px;
      font-weight: 600;
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .mini-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .mini-badge.approve {
      background: var(--emerald-bg);
      color: var(--emerald-text);
      border: 1px solid var(--emerald-border);
    }

    .mini-badge.review {
      background: var(--amber-bg);
      color: var(--amber-text);
      border: 1px solid var(--amber-border);
    }

    .mini-badge.blocked {
      background: var(--crimson-bg);
      color: var(--crimson-text);
      border: 1px solid var(--crimson-border);
    }

    .mini-badge.nocert {
      background: var(--slate-pill-bg);
      color: var(--slate-pill-text);
      border: 1px solid var(--border-strong);
    }

    .scen-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 3px;
    }

    .scen-sub {
      font-size: 12px;
      color: var(--ink-muted);
    }

    /* Stage Panel */
    .stage-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 26px 28px;
      box-shadow: var(--shadow-md);
    }

    .stage-header {
      border-bottom: 1px solid var(--border);
      padding-bottom: 18px;
      margin-bottom: 20px;
    }

    .stage-kicker {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--brand);
      margin-bottom: 6px;
    }

    .stage-title {
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.015em;
    }

    .stage-challenge {
      margin: 0;
      font-size: 14px;
      color: var(--ink-secondary);
    }

    /* Input & Candidates 2-col */
    .io-grid {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 18px;
      margin-bottom: 20px;
    }

    .subcard {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 16px 18px;
    }

    .subcard-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-muted);
      margin-bottom: 12px;
    }

    .field-row {
      margin-bottom: 10px;
    }

    .field-row:last-child {
      margin-bottom: 0;
    }

    .field-key {
      font-size: 11.5px;
      font-weight: 600;
      color: var(--ink-muted);
      margin-bottom: 3px;
    }

    .field-val {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 7px 10px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ink);
      min-height: 35px;
      display: flex;
      align-items: center;
    }

    .field-val.empty {
      color: var(--ink-muted);
      font-weight: 400;
      font-style: italic;
    }

    .parsed-chips {
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px dashed var(--border);
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .chip {
      font-size: 11.5px;
      padding: 2px 8px;
      border-radius: 6px;
      background: var(--slate-pill-bg);
      color: var(--slate-pill-text);
      font-weight: 500;
    }

    .cand-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .cand-row {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .cand-row.winner {
      border-color: var(--emerald-solid);
      background: var(--emerald-bg);
    }

    .cand-row.tied-winner {
      border-color: var(--amber-solid);
      background: var(--amber-bg);
    }

    .cand-id {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 11.5px;
      font-weight: 700;
      color: var(--ink-muted);
      margin-bottom: 2px;
    }

    .cand-addr {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--ink);
    }

    .cand-note {
      font-size: 11.5px;
      color: var(--ink-secondary);
      margin-top: 2px;
    }

    .cand-score-pill {
      font-size: 11.5px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 999px;
      white-space: nowrap;
      background: var(--slate-pill-bg);
      color: var(--slate-pill-text);
    }

    .cand-row.winner .cand-score-pill {
      background: var(--emerald-solid);
      color: #ffffff;
    }

    .cand-row.tied-winner .cand-score-pill {
      background: var(--amber-solid);
      color: #ffffff;
    }

    /* Naive vs Smart Comparison Callout */
    .comparison-banner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 20px;
    }

    .comp-box {
      border-radius: var(--radius-md);
      padding: 13px 16px;
      border: 1px solid var(--border);
    }

    .comp-box.naive {
      background: var(--crimson-bg);
      border-color: var(--crimson-border);
    }

    .comp-box.smart {
      background: var(--teal-bg);
      border-color: var(--teal-border);
    }

    .comp-label {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 4px;
    }

    .comp-box.naive .comp-label { color: var(--crimson-text); }
    .comp-box.smart .comp-label { color: var(--teal-text); }

    .comp-text {
      font-size: 13px;
      color: var(--ink);
      font-weight: 500;
    }

    /* Verdict & Audit Bottom Grid */
    .verdict-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 20px;
      background: var(--surface);
    }

    .verdict-top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 16px;
    }

    .score-cluster {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gauge-wrap {
      position: relative;
      width: 68px;
      height: 68px;
      flex-shrink: 0;
    }

    .gauge-wrap svg {
      transform: rotate(-90deg);
      width: 68px;
      height: 68px;
    }

    .gauge-num {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 16px;
      line-height: 1;
    }

    .gauge-num small {
      font-size: 9.5px;
      font-weight: 600;
      color: var(--ink-muted);
      margin-top: 2px;
    }

    .workflow-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 5px;
    }

    .workflow-badge.approve {
      background: var(--emerald-bg);
      color: var(--emerald-text);
      border: 1px solid var(--emerald-border);
    }

    .workflow-badge.review {
      background: var(--amber-bg);
      color: var(--amber-text);
      border: 1px solid var(--amber-border);
    }

