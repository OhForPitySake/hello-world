    const COMPONENT_LABELS = {
      unit: "Unit / Demise",
      floor: "Floor Level",
      street_number: "Street Number / Range",
      thoroughfare: "Street Thoroughfare",
      estate_or_building: "Building / Estate",
      tenant: "Tenant / Brand"
    };

    let currentFilter = "all";
    let currentScenarioId = SCENARIOS[0].id;

    function esc(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function getFilteredScenarios() {
      if (currentFilter === "all") return SCENARIOS;
      return SCENARIOS.filter(s => s.pillar === currentFilter);
    }

    function renderScenarioList() {
      const listEl = document.getElementById("scenarioList");
      const visible = getFilteredScenarios();
      if (!visible.some(s => s.id === currentScenarioId)) {
        currentScenarioId = visible[0].id;
      }

      listEl.innerHTML = visible.map(s => {
        const activeClass = s.id === currentScenarioId ? "active" : "";
        const pillLabel = s.workflowStatus === "approve"
          ? `✓ ${s.result.score}`
          : s.workflowStatus === "review"
            ? `⚑ ${s.result.score}`
            : s.workflowStatus === "nocert"
              ? `⊘ No Cert`
              : `✕ Blocked`;
        return `
          <button type="button" class="scenario-item ${activeClass}" data-id="${s.id}">
            <div class="scen-top">
              <span class="scen-cat-tag">${s.shortTag}</span>
              <span class="mini-badge ${s.workflowStatus}">${pillLabel}</span>
            </div>
            <div class="scen-title">${s.title}</div>
            <div class="scen-sub">${s.subtitle}</div>
          </button>
        `;
      }).join("");

      listEl.querySelectorAll(".scenario-item").forEach(btn => {
        btn.addEventListener("click", () => {
          currentScenarioId = btn.getAttribute("data-id");
          renderScenarioList();
          renderStage();
        });
      });
    }

    function setFieldBox(elId, val) {
      const el = document.getElementById(elId);
      if (val && val.trim()) {
        el.textContent = val;
        el.classList.remove("empty");
      } else {
        el.textContent = "(blank / not provided)";
        el.classList.add("empty");
      }
    }

    function renderStage() {
      const scen = SCENARIOS.find(s => s.id === currentScenarioId) || SCENARIOS[0];
      document.getElementById("stageKicker").textContent = scen.pillarLabel;
      document.getElementById("stageTitle").textContent = scen.title;
      document.getElementById("stageChallenge").textContent = scen.challenge;

      setFieldBox("qUnit", scen.query[0]);
      setFieldBox("qStreet", scen.query[1]);
      setFieldBox("qTenant", scen.query[2]);

      // Parsed diagnostic chips
      const pq = scen.result.parsed_query;
      const chips = [];
      if (pq.units && pq.units.length) chips.push(`Extracted Unit: ${pq.units.join(", ")}`);
      if (pq.floors && pq.floors.length) chips.push(`Extracted Floor: ${pq.floors.join(", ")}`);
      if (pq.street_numbers && pq.street_numbers.length) chips.push(`Street #: ${pq.street_numbers.join(", ")}`);
      if (pq.stripped_localities && pq.stripped_localities.length) {
        chips.push(`Stripped Town/County: ${pq.stripped_localities.map(w => w[0].toUpperCase() + w.slice(1)).join(", ")}`);
      }
      if (pq.stripped_postcode) chips.push(`Stripped Postcode: ${pq.stripped_postcode}`);
      document.getElementById("parsedChips").innerHTML = chips.map(c => `<span class="chip">${c}</span>`).join("");

      // Candidates
      document.getElementById("candCountLabel").textContent = `${scen.candidates.length} EPCs in Postcode`;
      document.getElementById("candList").innerHTML = scen.candidates.map(c => {
        const cls = c.winner ? "winner" : c.tied ? "tied-winner" : "";
        const badgeTxt = c.winner
          ? `Matched • ${c.score}`
          : c.tied
            ? `Tied Match • ${c.score}`
            : `Score ${c.score}`;
        return `
          <div class="cand-row ${cls}">
            <div>
              <div class="cand-id">${c.id}</div>
              <div class="cand-addr">${c.addr.filter(Boolean).join(", ")}</div>
              <div class="cand-note">${c.note}</div>
            </div>
            <span class="cand-score-pill">${badgeTxt}</span>
          </div>
        `;
      }).join("");

      // Comparison boxes
      document.getElementById("naiveText").textContent = scen.naiveComparison;
      document.getElementById("smartText").textContent = scen.smartComparison;

      // Gauge & Workflow Verdict
      const score = scen.result.score;
      document.getElementById("scoreVal").textContent = score.toFixed(1).replace(/\.0$/, "");
      const circumference = 175.9;
      const offset = circumference - (Math.min(100, Math.max(0, score)) / 100) * circumference;
      const arc = document.getElementById("gaugeArc");
      arc.style.strokeDashoffset = String(offset);

      const strokeColor = scen.workflowStatus === "approve"
        ? "var(--emerald-solid)"
        : scen.workflowStatus === "review"
          ? "var(--amber-solid)"
          : scen.workflowStatus === "nocert"
            ? "var(--ink-muted)"
            : "var(--crimson-solid)";
      arc.style.stroke = strokeColor;

      const wfBadge = document.getElementById("workflowBadge");
      wfBadge.className = `workflow-badge ${scen.workflowStatus}`;
      wfBadge.textContent = scen.workflowLabel;

      const headline = scen.workflowStatus === "nocert"
        ? "Exempt / Non-EPC Structure Isolated — No EPC Certificate Required (Score 0.0)"
        : scen.result.best_match_id
          ? scen.result.tied_ids.length > 1
            ? `Matched Parent Building across ${scen.result.tied_ids.length} Tied EPCs (${scen.result.tied_ids.join(" & ")})`
            : `Selected Certificate ${scen.result.best_match_id}: "${scen.result.best_match_address.join(", ")}"`
          : "No Certificate Assigned — False-Positive Match Safely Prevented";
      document.getElementById("verdictHeadline").textContent = headline;

      // Reasons list
      const bulletType = scen.workflowStatus === "approve" ? "ok" : scen.workflowStatus === "review" ? "warn" : "stop";
      const bulletChar = scen.workflowStatus === "approve" ? "✓" : scen.workflowStatus === "review" ? "!" : scen.workflowStatus === "nocert" ? "⊘" : "✕";
      document.getElementById("auditReasons").innerHTML = scen.result.reasons.map(r => `
        <li>
          <span class="audit-bullet ${bulletType}">${bulletChar}</span>
          <span>${esc(r)}</span>
        </li>
      `).join("");

      // Component bars (only show active relevant components for clarity)
      const cs = scen.result.component_scores;
      document.getElementById("compBars").innerHTML = scen.activeComponents.map(key => {
        const val = cs[key] || 0;
        const barColor = val >= 80 ? "var(--emerald-solid)" : val >= 50 ? "var(--amber-solid)" : "var(--crimson-solid)";
        return `
          <div class="bar-item">
            <div class="bar-head">
              <span>${COMPONENT_LABELS[key]}</span>
              <span>${val.toFixed(0)}%</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style="width:${val}%; background:${barColor};"></div>
            </div>
          </div>
        `;
      }).join("");

      // Raw JSON output
      document.getElementById("rawJsonBox").textContent = JSON.stringify(scen.result, null, 2);
    }

    // Pillar tabs
    document.querySelectorAll("#pillarTabs .filter-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        document.querySelectorAll("#pillarTabs .filter-tab").forEach(t => t.classList.remove("active"));
        tab.classList.add("active");
        currentFilter = tab.getAttribute("data-pillar");
        renderScenarioList();
        renderStage();
      });
    });

    // Prev / Next buttons
    document.getElementById("prevScenarioBtn").addEventListener("click", () => {
      const visible = getFilteredScenarios();
      const idx = visible.findIndex(s => s.id === currentScenarioId);
      const prevIdx = (idx - 1 + visible.length) % visible.length;
      currentScenarioId = visible[prevIdx].id;
      renderScenarioList();
      renderStage();
    });

    document.getElementById("nextScenarioBtn").addEventListener("click", () => {
      const visible = getFilteredScenarios();
      const idx = visible.findIndex(s => s.id === currentScenarioId);
      const nextIdx = (idx + 1) % visible.length;
      currentScenarioId = visible[nextIdx].id;
      renderScenarioList();
      renderStage();
    });

    // Raw JSON drawer toggle
    document.getElementById("rawToggleBtn").addEventListener("click", () => {
      const box = document.getElementById("rawJsonBox");
      const arrow = document.getElementById("rawToggleArrow");
      const isOpen = box.classList.toggle("open");
      arrow.textContent = isOpen ? "▾" : "▸";
    });

    // Light / Dark presentation mode toggle
    document.getElementById("themeToggle").addEventListener("click", () => {
      const html = document.documentElement;
      const next = html.getAttribute("data-theme") === "dark" ? "light" : "dark";
      html.setAttribute("data-theme", next);
      document.getElementById("themeIcon").textContent = next === "dark" ? "☀️" : "🌙";
      document.getElementById("themeLabel").textContent = next === "dark" ? "Light Executive Mode" : "Dark Presentation Mode";
    });

    // Initial render
    renderScenarioList();
    renderStage();
  </script>
</body>
</html>
